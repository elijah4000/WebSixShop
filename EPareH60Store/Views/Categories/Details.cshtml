@model EPareH60Store.Models.ProductCategory

@{
    ViewData["Title"] = "Category Details";
}

<h1>Category Details</h1>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Category Name</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.ProdCat)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.CategoryID" class="btn btn-primary">Edit</a> 
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>