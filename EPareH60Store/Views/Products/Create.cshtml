@model EPareH60Store.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<h1>Create Product</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            @section Scripts {
                @await Html.PartialAsync("_ValidationScriptsPartial")
            }
            
            <div class="form-group mt-2">
                <label asp-for="ProdCatId" class="control-label">Category</label>
                @{
                    var cats = ViewData["CategoriesList"] as IEnumerable<EPareH60Store.Models.ProductCategory>;
                }
                @if (cats != null && cats.Any())
                {
                    <select asp-for="ProdCatId" class="form-control">
                        @foreach (var c in cats)
                        {
                            <option value="@c.CategoryId">@c.ProdCat</option>
                        }
                    </select>
                }
                else
                {
                    <select asp-for="ProdCatId" class="form-control" asp-items="ViewBag.ProdCatId"></select>
                }
            </div>
            <div class="form-group mt-2">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <label asp-for="Manufacturer" class="control-label"></label>
                <input asp-for="Manufacturer" class="form-control" />
                <span asp-validation-for="Manufacturer" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <label asp-for="Stock" class="control-label"></label>
                <input asp-for="Stock" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <label asp-for="BuyPrice" class="control-label"></label>
                <input asp-for="BuyPrice" class="form-control" placeholder="0.00" />
                <span asp-validation-for="BuyPrice" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <label asp-for="SellPrice" class="control-label"></label>
                <input asp-for="SellPrice" class="form-control" placeholder="0.00" />
                <span asp-validation-for="SellPrice" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>