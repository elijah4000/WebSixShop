@model EPareH60Store.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Category</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Category.ProdCat)</dd>
        
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Description)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Description)</dd>
        
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Manufacturer)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Manufacturer)</dd>
        
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Stock)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Stock)</dd>
        
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.BuyPrice)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.BuyPrice)</dd>
        
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.SellPrice)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.SellPrice)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ProductID" class="btn btn-primary">Edit</a> 
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>