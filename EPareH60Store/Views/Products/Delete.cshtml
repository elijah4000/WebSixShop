@model EPareH60Store.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>
<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Category</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Category.ProdCat)</dd>
        
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Description)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Description)</dd>
        
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Manufacturer)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Manufacturer)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="ProductID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> 
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>